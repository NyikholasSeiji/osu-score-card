# Create an OAuth app at https://osu.ppy.sh/home/account/edit#oauth
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
PORT=3000

# Public URL of the frontend. The OAuth "Application Callback URL" registered
# on osu! must be exactly: <APP_URL>/api/auth/osu/callback
# (on Render this defaults to RENDER_EXTERNAL_URL, so it can be left unset)
APP_URL=http://localhost:5173

# Optional: directory with the built frontend to serve from this process
# (production). Example: STATIC_DIR=../frontend/dist
